rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Legacy keys plus per-book namespaces: gc_history__book_ssc_sample
    function isValidKey(key) {
      return key.matches('^(gc_mistakes|gc_bookmarks|gc_skips|gc_history|gc_archive|gc_attempts)(__book_[a-zA-Z0-9_-]+)?$');
    }

    function isValidPayload() {
      return request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 900000
        && request.resource.data.updatedAt is number;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      match /data/{dataKey} {
        // List/get are owner-only and do not depend on the document id, so a
        // collection query and per-document listeners both succeed.
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidKey(dataKey)
          && isValidPayload();
        allow delete: if isOwner(userId);
      }
    }
  }
}
