rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidKey(key) {
      return key.matches('^(gc_mistakes|gc_bookmarks|gc_skips|gc_history|gc_archive|gc_attempts)(__book_[a-zA-Z0-9_]+)?$');
    }

    match /users/{userId}/data/{dataKey} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidKey(dataKey)
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 900000
        && request.resource.data.updatedAt is number;
      allow delete: if isOwner(userId);
    }
  }
}
